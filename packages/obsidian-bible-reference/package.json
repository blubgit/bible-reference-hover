    "obsidian plugin",
    "obsidian bible"
  ],
  "author": "blubgit",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@types/node": "24.3.0",
    "builtin-modules": "3.3.0",
    "bun-types": "^1.1.0",
    "esbuild": "0.28.1",
    "obsidian": "1.8.7",
    "tslib": "^2.8.1",
    "typescript": "5.3.3"
  },
  "dependencies": {
    "bible-reference-toolkit": "workspace:*"
  }
}
