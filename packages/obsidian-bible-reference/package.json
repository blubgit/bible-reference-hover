{
  "name": "bible-reference-hover",
  "version": "1.0.0",
  "private": true,
  "description": "Preview, edit, and embed Bible passages from references in surrounding text.",
  "main": "../../main.js",
  "scripts": {
    "dev": "bun scripts/esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && bun scripts/esbuild.config.mjs production",
    "version": "bun scripts/version-bump.mjs",
    "test": "bun test"
  },
  "keywords": [
    "bible",
    "bible reference",
    "bible notes",
    "bible study",
    "theology study",
    "obsidian",
